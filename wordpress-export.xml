      <category domain="post_tag" nicename="wordpress"><![CDATA[WordPress]]></category>
    </item>
    <item>
      <title><![CDATA[Bring the next export]]></title>
      <link>https://wordpress.example/refresh-your-preview/</link>
      <dc:creator><![CDATA[editor]]></dc:creator>
      <content:encoded><![CDATA[<p>Made changes in WordPress? Export again, replace <code>wordpress-export.xml</code>, and push. There is no second content file to maintain.</p><h2>When you are ready to move</h2><p>For a full move away from WordPress, import your WXR into ZeroPress Studio and publish to a new Studio Starter repository.</p><p>This repository is for trying ZeroPress with the WordPress resources you already have.</p>]]></content:encoded>
      <excerpt:encoded><![CDATA[Replace the export whenever you want to refresh this site.]]></excerpt:encoded>
