    <item>
      <title><![CDATA[Your WordPress content, in ZeroPress]]></title>
      <link>https://wordpress.example/try-your-export/</link>
      <dc:creator><![CDATA[editor]]></dc:creator>
      <content:encoded><![CDATA[<p>This sample site was built from a WordPress WXR export using the Minimal theme.</p><h2>Try it with your own posts</h2><ol><li>In WordPress, open <strong>Tools → Export</strong> and choose <strong>All content</strong>.</li><li>Replace <code>wordpress-export.xml</code> in your repository with the downloaded file.</li><li>Commit and push. Cloudflare builds your new site automatically.</li></ol><p>Your published posts and pages will replace these examples on the next build.</p>]]></content:encoded>
      <excerpt:encoded><![CDATA[Replace one XML file to see your WordPress posts in ZeroPress.]]></excerpt:encoded>
      <wp:post_id>101</wp:post_id>
      <wp:post_date><![CDATA[2026-09-20 09:00:00]]></wp:post_date>
      <wp:post_date_gmt><![CDATA[2026-09-20 09:00:00]]></wp:post_date_gmt>
      <wp:post_modified_gmt><![CDATA[2026-09-20 09:00:00]]></wp:post_modified_gmt>
      <wp:post_name><![CDATA[try-your-export]]></wp:post_name>
      <wp:post_type><![CDATA[post]]></wp:post_type>
